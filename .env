# ── Paper Trade（simulate）模式 ──
MR_PAPER=0                       # 1 = simulate，唔落真實訂單

# ── 可以用假地址，paper mode 唔驗證 ──
HYPERLIQUID_WALLET=0x45d7ab3F1cC4B43779b7d931e2D8150E672E2C6b
HYPERLIQUID_PRIVATE_KEY=0x4c2537f5c33882ac6f9d798ff9947af9c03ef4721a9fc2e1e8b02c4ee066b2de

# ── 以下全部有預設值，唔填就用預設 ──
MR_EQUITY_USDT=600               # 實際資金

# ── 靜態幣池（50 隻，按組別分類）────────────────────────────────────────────
# G1  Layer 1 大盤 (6)：    BTC ETH SOL AVAX ADA DOT
# G2  DeFi 藍籌 (7)：       AAVE LINK UNI INJ ATOM CRV LDO
# G3  L2 / Modular (7)：    ARB OP NEAR APT TIA SEI JUP
# G4  HL 生態+高量 (5)：    HYPE SUI DOGE LTC AXS
# G5  Alt L1 (6)：           XRP TON BCH ETC FTM ALGO
# G6  AI / Infra (5)：       FET RNDR TAO WLD GRT
# G7  DeFi 延伸 (5)：        MKR SNX COMP GMX PENDLE
# G8  Gaming / NFT (5)：    IMX SAND MANA GALA FIL
# G9  高量其他 (4)：         XLM MATIC TRUMP PEPE
MR_SYMBOLS=BTC/USDC:USDC,ETH/USDC:USDC,SOL/USDC:USDC,AVAX/USDC:USDC,ADA/USDC:USDC,DOT/USDC:USDC,AAVE/USDC:USDC,LINK/USDC:USDC,UNI/USDC:USDC,INJ/USDC:USDC,ATOM/USDC:USDC,CRV/USDC:USDC,LDO/USDC:USDC,ARB/USDC:USDC,OP/USDC:USDC,NEAR/USDC:USDC,APT/USDC:USDC,TIA/USDC:USDC,SEI/USDC:USDC,JUP/USDC:USDC,HYPE/USDC:USDC,SUI/USDC:USDC,DOGE/USDC:USDC,LTC/USDC:USDC,AXS/USDC:USDC,XRP/USDC:USDC,TON/USDC:USDC,BCH/USDC:USDC,ETC/USDC:USDC,FTM/USDC:USDC,ALGO/USDC:USDC,FET/USDC:USDC,RNDR/USDC:USDC,TAO/USDC:USDC,WLD/USDC:USDC,WIF/USDC:USDC,MKR/USDC:USDC,SNX/USDC:USDC,COMP/USDC:USDC,GMX/USDC:USDC,PENDLE/USDC:USDC,IMX/USDC:USDC,SAND/USDC:USDC,PYTH/USDC:USDC,GALA/USDC:USDC,FIL/USDC:USDC,XLM/USDC:USDC,MATIC/USDC:USDC,TRUMP/USDC:USDC,ONDO/USDC:USDC

# 50 隻 × ~3s/fetch ≈ 150s；用 180s bar 確保有足夠時間完成一輪
MR_POLL_SEC=180                   # 3 分鐘 bar（50 隻幣）
MR_Z_ENTRY=1.6                    # |Z| 入場門檻
MR_TIMEOUT_BARS=20                # 20 bars × 3min = 60 min 強平
MR_ATR_MULT=1.5                   # SL = 1.5× ATR，再由 bps clamp [15, 80] 保護跨幣一致性
MR_LOG_FILE=mr_trades.csv         # 交易記錄輸出

MR_UNIVERSE_SCAN=0                # 0=靜態幣池 / 1=動態掃描
MR_UNIVERSE_RESCAN_H=4            # 每4小時換幣（universe scan 模式用）
MR_UNIVERSE_TOP_K=8               # 動態模式：最多同時監控幾多隻
MR_UNIVERSE_MIN_VOL=3000000
MR_UNIVERSE_OHLCV_BARS=200        # 200 bars 足夠 VR 計算
MR_UNIVERSE_RELAX_HURST=0.58

# Position sizing（根據真實資金同交易所最低下單量調整）
# Hyperliquid 最低 notional = $10 USDT
# 公式：MR_MIN_FRACTION × MR_EQUITY_USDT ≥ 10
# $600 × 2%  = $12    ✓ 高於 HL $10 minimum，Quarter-Kelly 可自由發揮
# $600 × 10% = $60    上限，單倉唔超過 10%，最多可同時開 10 倉
MR_MIN_FRACTION=0.02
MR_MAX_FRACTION=0.10

# ── RegimePauseGuard（全局 SL 熔斷）────────────────────────────────────────
# 當 24h 內全局 SL 達到此數，暫停所有新開倉 MR_GLOBAL_SL_PAUSE_H 小時
# 93 筆分析：52 SL 分佈多個 session，觸發值設 8 可在連發前熔斷
MR_GLOBAL_SL_THRESHOLD=8    # 24h SL 次數上限
MR_GLOBAL_SL_PAUSE_H=4      # 熔斷暫停時數

# ── 暫時排除已確認 trending 主導的幣 ────────────────────────────────────────
# 根據 93 筆分析：COMP(9SL/10筆)、BCH(7SL/14筆)、TAO(7SL/11筆)、BTC(6SL/9筆)
# 等 VR 指標恢復 mean-reverting 特性後再重新加入
MR_EXCLUDE_SYMBOLS=COMP/USDC:USDC,BCH/USDC:USDC,TAO/USDC:USDC,BTC/USDC:USDC

MR_MAX_SIZE_MULT=3.0              # size_mult 硬上限
MR_COOLDOWN_HOURS=4.0             # 坐監時長
MR_COOLDOWN_MAX_SL=2              # 24h 內幾多次 SL 觸發
MR_COOLDOWN_FILE=cooldown_state.json
MR_CORR_THRESHOLD=0.6
MR_DD_LIMIT=0.005                 # drawdown 上限（0.5%）